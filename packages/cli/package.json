{
    "name": "@axisparkjs/cli",
    "version": "1.3.0",
    "description": "AxiSpark.js - The Ultimate Node.js Framework - @axisparkjs/cli",
    "author": "Pablo Gálvez Ortuño",
    "license": "Apache-2.0",
    "bin": {
        "axispark": "./lib/index.js"
    },
    "files": [
        "lib",
        "package.json",
        "PACKAGE.md",
        "README.md",
        "LICENSE",
        "tsconfig.build.json"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "prettier": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore '**/*.{ts,js,mjs,json,md,html,css,scss}' --check",
        "lint": "eslint --config ../../eslint.config.mjs .",
        "test:unit": "export NODE_ENV=test && jest --config jest.config.ts",
        "sonar": "sonar-scanner -Dsonar.projectKey=axisparkjs-cli"
    },
    "engines": {
        "node": ">= 24"
    },
    "dependencies": {
        "chalk": "^4.1.2",
        "commander": "^14.0.3",
        "execa": "^5.1.1",
        "ora": "^9.4.1",
        "prompts": "^2.4.2",
        "tar": "^7.5.22"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/prompts": "^2.4.9",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0"
    }
}
