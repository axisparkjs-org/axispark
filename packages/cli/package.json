{
    "name": "@axisparkjs/cli",
    "version": "1.5.1",
    "description": "AxiSpark.js - The Ultimate Node.js Framework - @axisparkjs/cli",
    "author": "Pablo Gálvez Ortuño",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/axisparkjs-org/axispark.git",
        "directory": "packages/cli"
    },
    "homepage": "https://axisparkjs.com",
    "bugs": "https://github.com/axisparkjs-org/axispark/issues",
    "keywords": [
        "axispark",
        "nodejs",
        "typescript",
        "framework",
        "cli",
        "scaffolding",
        "generator"
    ],
    "bin": {
        "axispark": "./lib/index.js"
    },
    "files": [
        "lib",
        "package.json",
        "PACKAGE.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "prettier": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore '**/*.{ts,js,mjs,json,md,html,css,scss}' --check",
        "lint": "eslint --config ../../eslint.config.mjs .",
        "test:unit": "export NODE_ENV=test && jest --config jest.config.ts",
        "sonar": "sonar-scanner -Dsonar.projectKey=axisparkjs-cli"
    },
    "engines": {
        "node": ">= 24"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "commander": "^15.1.0",
        "execa": "^5.1.1",
        "ora": "^10.0.0",
        "prompts": "^2.4.2",
        "tar": "^7.5.22"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/prompts": "^2.4.9",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    }
}
