{
    "name": "@axisparkjs/http-fastify",
    "version": "1.5.1",
    "description": "AxiSpark.js - The Ultimate Node.js Framework - @axisparkjs/http-fastify",
    "author": "Pablo Gálvez Ortuño",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/axisparkjs-org/axispark.git",
        "directory": "packages/http-fastify"
    },
    "homepage": "https://axisparkjs.com",
    "bugs": "https://github.com/axisparkjs-org/axispark/issues",
    "keywords": [
        "axispark",
        "nodejs",
        "typescript",
        "framework",
        "http",
        "fastify",
        "adapter"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "package.json",
        "PACKAGE.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "prettier": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore '**/*.{ts,js,mjs,json,md,html,css,scss}' --check",
        "lint": "eslint --config ../../eslint.config.mjs .",
        "test:unit": "export NODE_ENV=test && jest --config jest.config.ts",
        "sonar": "sonar-scanner -Dsonar.projectKey=axisparkjs-http-fastify"
    },
    "engines": {
        "node": ">= 24"
    },
    "dependencies": {
        "@axisparkjs/common": "1.5.1",
        "@axisparkjs/core": "1.5.1",
        "@axisparkjs/di": "1.5.1",
        "@axisparkjs/http": "1.5.1",
        "@axisparkjs/logger": "1.5.1",
        "@fastify/compress": "^9.3.0",
        "@fastify/cookie": "^11.1.5",
        "@fastify/cors": "^11.4.1",
        "@fastify/formbody": "^9.0.1",
        "@fastify/multipart": "^10.1.8",
        "@fastify/session": "^11.1.6",
        "@fastify/static": "^10.1.10",
        "fastify": "^5.12.8"
    }
}
