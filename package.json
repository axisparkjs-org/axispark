{
    "name": "@axisparkjs/axispark",
    "version": "0.0.1",
    "description": "AxiSpark.js - The Ultimate Node.js Framework",
    "author": "Pablo Gálvez Ortuño",
    "license": "Apache-2.0",
    "scripts": {
        "prettier:fix": "prettier --config .prettierrc.json '**/*.{ts,js,mjs,json,md,html,css,scss}' --write",
        "prettier": "turbo run prettier",
        "lint": "turbo run lint",
        "build": "turbo run build",
        "test:unit": "export NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules && turbo run test:unit",
        "test:e2e": "export NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules && jest --config jest.e2e.config.ts",
        "sonar": "turbo run sonar",
        "test:docker:up": "docker compose -f e2e/docker-compose.yml up -d --wait",
        "test:docker:down": "docker compose -f e2e/docker-compose.yml down",
        "test:docker:logs": "docker compose -f e2e/docker-compose.yml logs -f",
        "docs:api-generate": "typedoc --options typedoc.json",
        "docs:ci": "npm --prefix ./website ci",
        "docs:start": "npm --prefix ./website run start",
        "docs:build": "npm --prefix ./website run build",
        "ci:prettier": "turbo run prettier --affected",
        "ci:lint": "turbo run lint --affected",
        "ci:build": "turbo run build --affected",
        "ci:test:unit": "export NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules && turbo run test:unit --affected",
        "ci:test:e2e": "export NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules && jest --config jest.e2e.config.ts",
        "ci:sonar": "turbo run sonar --affected",
        "cd:changeset": "changeset",
        "cd:version": "changeset version",
        "cd:publish": "changeset publish"
    },
    "engines": {
        "node": ">= 24"
    },
    "private": true,
    "packageManager": "npm@11.16.0",
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^9.37.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "eslint": "^9.37.0",
        "globals": "^16.2.0",
        "jest": "^30.5.2",
        "mongodb": "^7.7.0",
        "mysql2": "^3.24.6",
        "pg": "^8.23.1",
        "prettier": "^3.9.10",
        "socket.io-client": "^4.8.4",
        "sonar-scanner": "^3.1.0",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.15",
        "turbo": "^2.11.10",
        "typedoc": "^0.28.20",
        "typedoc-docusaurus-theme": "^1.4.3",
        "typedoc-plugin-markdown": "^4.14.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    }
}
