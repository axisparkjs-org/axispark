{
    "name": "observability",
    "version": "1.0.0",
    "description": "Traces, metrics and logs with OpenTelemetry in AxiSpark.js, exported to an OpenTelemetry Collector, Prometheus and Jaeger",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.bootstrap.js",
        "dev": "ts-node src/index.bootstrap.ts",
        "lint": "eslint . --ext .ts",
        "prettier": "prettier .",
        "infra:up": "docker compose up -d",
        "infra:down": "docker compose down"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@types/node": "^24.13.2",
        "eslint": "^9.37.0",
        "globals": "^16.2.0",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0"
    },
    "dependencies": {
        "reflect-metadata": "^0.2.2",
        "@axisparkjs/common": "0.0.2",
        "@axisparkjs/core": "0.0.2",
        "@axisparkjs/di": "0.0.2",
        "@axisparkjs/engine": "0.0.2",
        "@axisparkjs/http": "0.0.2",
        "@axisparkjs/http-express": "0.0.2",
        "@axisparkjs/logger": "0.0.2",
        "@axisparkjs/schedule": "0.0.2",
        "@axisparkjs/store": "0.0.2",
        "@axisparkjs/telemetry": "0.0.2",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
        "@opentelemetry/sdk-metrics": "^3.1.0",
        "@opentelemetry/sdk-node": "^0.301.0"
    }
}
