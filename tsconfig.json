{
    "compilerOptions": {
        "target": "es2016",
        "lib": ["ES2021", "ES2023"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "removeComments": true,
        "module": "commonjs",
        "declaration": true,
        "noLib": false,
        "rootDir": "packages",
        "outDir": "lib",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "allowJs": false,
        "strict": true,
        "noImplicitAny": true,
        "strictPropertyInitialization": false,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "paths": {
            "@axisparkjs/common": ["./packages/common/src"],
            "@axisparkjs/common/*": ["./packages/common/src/*"],
            "@axisparkjs/core": ["./packages/core/src"],
            "@axisparkjs/core/*": ["./packages/core/src/*"],
            "@axisparkjs/data": ["./packages/data/src"],
            "@axisparkjs/data/*": ["./packages/data/src/*"],
            "@axisparkjs/ddd": ["./packages/ddd/src"],
            "@axisparkjs/ddd/*": ["./packages/ddd/src/*"],
            "@axisparkjs/di": ["./packages/di/src"],
            "@axisparkjs/di/*": ["./packages/di/src/*"],
            "@axisparkjs/engine": ["./packages/engine/src"],
            "@axisparkjs/engine/*": ["./packages/engine/src/*"],
            "@axisparkjs/http": ["./packages/http/src"],
            "@axisparkjs/http/*": ["./packages/http/src/*"],
            "@axisparkjs/http-express": ["./packages/http-express/src"],
            "@axisparkjs/http-express/*": ["./packages/http-express/src/*"],
            "@axisparkjs/http-fastify": ["./packages/http-fastify/src"],
            "@axisparkjs/http-fastify/*": ["./packages/http-fastify/src/*"],
            "@axisparkjs/security": ["./packages/security/src"],
            "@axisparkjs/security/*": ["./packages/security/src/*"],
            "@axisparkjs/kafka": ["./packages/kafka/src"],
            "@axisparkjs/kafka/*": ["./packages/kafka/src/*"],
            "@axisparkjs/logger": ["./packages/logger/src"],
            "@axisparkjs/logger/*": ["./packages/logger/src/*"],
            "@axisparkjs/mcp": ["./packages/mcp/src"],
            "@axisparkjs/mcp/*": ["./packages/mcp/src/*"],
            "@axisparkjs/openapi": ["./packages/openapi/src"],
            "@axisparkjs/openapi/*": ["./packages/openapi/src/*"],
            "@axisparkjs/rabbitmq": ["./packages/rabbitmq/src"],
            "@axisparkjs/rabbitmq/*": ["./packages/rabbitmq/src/*"],
            "@axisparkjs/redis": ["./packages/redis/src"],
            "@axisparkjs/redis/*": ["./packages/redis/src/*"],
            "@axisparkjs/schedule": ["./packages/schedule/src"],
            "@axisparkjs/schedule/*": ["./packages/schedule/src/*"],
            "@axisparkjs/store": ["./packages/store/src"],
            "@axisparkjs/store/*": ["./packages/store/src/*"],
            "@axisparkjs/test": ["./packages/test/src"],
            "@axisparkjs/test/*": ["./packages/test/src/*"],
            "@axisparkjs/websocket": ["./packages/websocket/src"],
            "@axisparkjs/websocket/*": ["./packages/websocket/src/*"],
            "@axisparkjs/websocket-socketio": ["./packages/websocket-socketio/src"],
            "@axisparkjs/websocket-socketio/*": ["./packages/websocket-socketio/src/*"],
            "@axisparkjs/samples": ["./samples"],
            "@axisparkjs/samples/*": ["./samples/*"]
        },
        "types": ["node", "jest"]
    },
    "include": ["packages/**/*"],
    "exclude": ["node_modules", "lib", "**/jest.config.ts"]
}
